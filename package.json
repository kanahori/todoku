{
  "name": "hackathon2026",
  "version": "1.0.0",
  "description": "Card-based accessible front end for web apps (Electron)",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "smoke": "electron test/smoke.js",
    "ui:repair": "electron test/ui-repair.js",
    "dist:win": "electron-builder --win --arm64 --x64",
    "dist:mac": "electron-builder --mac dmg --arm64"
  },
  "build": {
    "appId": "jp.example.hackathon2026.cards",
    "productName": "hackathon2026",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "cards/**/*.json",
      "test/fixtures/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanahori/hackathon2026.git"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/kanahori/hackathon2026/issues"
  },
  "homepage": "https://github.com/kanahori/hackathon2026#readme",
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "private": true,
  "overrides": {
    "@electron/asar": "^4.3.1",
    "rimraf": "^5.0.10",
    "glob": "^13.0.6"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "zod": "^4.6.7"
  }
}
