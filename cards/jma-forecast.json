    },
    {
      "id": "tokyo-weather",
      "title": "東京地方の天気（今日・明日・明後日）",
      "action": "list",
      "selector": "#short-table-container .contents-wide-table-scroll .forecast-table tr:nth-child(4) > td.forecast-sentence",
      "description": "今日・明日・明後日の順に読みます"
    },
    {
      "id": "tokyo-max",
      "title": "東京の日中の最高気温（度）",
      "action": "list",
      "selector": "#short-table-container .contents-wide-table-scroll .forecast-table tr:nth-child(11) > td.forecast-max-temp",
      "description": "今日・明日の順に読みます"
    },
    {
      "id": "tokyo-min",
      "title": "東京の朝の最低気温（度）",
      "action": "list",
      "selector": "#short-table-container .contents-wide-table-scroll .forecast-table tr:nth-child(11) > td.forecast-min-temp",
