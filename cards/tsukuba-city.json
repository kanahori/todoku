{
  "id": "tsukuba-city",
  "name": "つくば市公式ウェブサイト",
  "description": "出典：つくば市公式ウェブサイト。つくば市の公式サイトのページを開いて、書いてあるとおりに読みます。",
  "sourceUrl": "https://www.city.tsukuba.lg.jp/",
  "url": "https://www.city.tsukuba.lg.jp/",
  "cards": [
    {
      "id": "emergency",
      "title": "緊急情報を読む",
      "action": "list",
      "selector": ".top-emergency .category-contents ul.list > li",
      "container": ".top-emergency .category-contents",
      "description": "出典：つくば市公式ウェブサイト。災害などの緊急のお知らせの日付と題です。"
    },
    {
      "id": "news",
      "title": "新着情報を読む",
      "action": "list",
      "selector": ".top-topic .news-box ul.news-list > li",
      "container": ".top-topic .news-box .list-box",
      "description": "新しく掲載されたページの日付と題です。"
    },
    {
      "id": "notice",
      "title": "お知らせを読む",
      "action": "list",
      "selector": ".top-topic .notice-box ul.news-list > li",
      "container": ".top-topic .notice-box .list-box"
    },
    {
      "id": "events",
      "title": "イベント情報を読む（今月）",
      "action": "list",
      "path": "/calendar.html?eventTypeNo=1&type-display=0&area-display=0",
      "selector": "#calListTable tr.calListRow .calPageLink",
      "container": "#calListTable",
      "dateSelector": "td.date",
      "tagSelector": ".event_icon",
      "description": "イベントカレンダーにある、今月の催しの日付と題です。"
    },
    {
      "id": "carousel",
      "title": "トップの画像のお知らせを全部読む",
      "action": "list",
      "selector": ".wrap-mv ul.mv-slider > li:not(.bx-clone) > a",
      "description": "トップページの上に、画像で順に出るお知らせです。"
    },
    {
      "id": "pickup",
      "title": "ピックアップを全部読む",
      "action": "list",
      "selector": ".top-pickup ul.pickup-slider > li:not(.bx-clone) > a",
      "description": "トップページの「ピックアップ」に並ぶ、注目のページの案内です。"
    },
    {
      "id": "kurashi",
      "title": "くらしの情報（こんなときは）を読む",
      "action": "list",
      "selector": ".top-kurashi .konnatoki-box ul.list > li"
    }
  ]
}
