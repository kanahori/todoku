{
  "id": "jma-daily",
  "name": "気象庁 過去の気象データ検索（東京の日ごとの値）",
  "description": "出典：気象庁ホームページを加工して作成。",
  "sourceUrl": "https://www.data.jma.go.jp/stats/etrn/index.php",
  "url": "https://www.data.jma.go.jp/stats/etrn/view/daily_s1.php?prec_no=44&block_no=47662&year=2026&month=11",
  "cards": [
    {
      "id": "table-title",
      "title": "表の地点と月",
      "action": "read",
      "selector": "h3:has(+ #tablefix1)",
      "description": "出典：気象庁ホームページを加工して作成。"
    },
    {
      "id": "latest-day",
      "title": "値が入っている最新の日",
      "action": "read",
      "selector": "#tablefix1 tr:has(> td:nth-child(7):not(:empty)):is(:last-child, :has(+ tr > td:nth-child(7):empty)) > td:nth-child(1)",
      "description": "表の中で、値が入っているいちばん新しい日の日付です。"
    },
    {
      "id": "latest-mean",
      "title": "最新の日の平均気温（度）",
      "action": "read",
      "selector": "#tablefix1 tr:has(> td:nth-child(7):not(:empty)):is(:last-child, :has(+ tr > td:nth-child(7):empty)) > td:nth-child(7)"
    },
    {
      "id": "latest-max",
      "title": "最新の日の最高気温（度）",
      "action": "read",
      "selector": "#tablefix1 tr:has(> td:nth-child(7):not(:empty)):is(:last-child, :has(+ tr > td:nth-child(7):empty)) > td:nth-child(8)"
    },
    {
      "id": "latest-min",
      "title": "最新の日の最低気温（度）",
      "action": "read",
      "selector": "#tablefix1 tr:has(> td:nth-child(7):not(:empty)):is(:last-child, :has(+ tr > td:nth-child(7):empty)) > td:nth-child(9)"
    },
    {
      "id": "latest-rain",
      "title": "最新の日の降水量の合計（ミリ）",
      "action": "read",
      "selector": "#tablefix1 tr:has(> td:nth-child(7):not(:empty)):is(:last-child, :has(+ tr > td:nth-child(7):empty)) > td:nth-child(4)"
    },
    {
      "id": "latest-weather-day",
      "title": "最新の日の天気概況（昼）",
      "action": "read",
      "selector": "#tablefix1 tr:has(> td:nth-child(7):not(:empty)):is(:last-child, :has(+ tr > td:nth-child(7):empty)) > td:nth-child(20)",
      "description": "6時から18時までの天気です。"
    },
    {
      "id": "latest-weather-night",
      "title": "最新の日の天気概況（夜）",
      "action": "read",
      "selector": "#tablefix1 tr:has(> td:nth-child(7):not(:empty)):is(:last-child, :has(+ tr > td:nth-child(7):empty)) > td:nth-child(21)",
      "description": "18時から翌日6時までの天気です。"
    },
    {
      "id": "month-mean",
      "title": "この月の日ごとの平均気温（度）",
      "action": "list",
      "selector": "#tablefix1 tr > td:nth-child(7):not(:empty)",
      "container": "#tablefix1",
      "description": "1日から、値が入っている日までの平均気温です。"
    }
  ]
}
